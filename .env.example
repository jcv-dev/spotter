# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma separated list, required when serving behind a https proxy (Dokploy/Traefik)
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Database (Postgres)
# docker-compose exposes Postgres on host port 55432 (see docker-compose.yml).
DATABASE_URL=postgres://fuel:fuel@localhost:55432/fuel_route

# OpenRouteService (https://openrouteservice.org/dev/#/signup)
OPENROUTESERVICE_API_KEY=your-openrouteservice-api-key

# Optional: Redis cache. When unset the project uses Django's local-memory cache.
# REDIS_URL=redis://localhost:6379/0

# Optional tuning (defaults shown)
# ROUTE_CACHE_TTL=3600
# GEOCODE_CACHE_TTL=86400
# ORS_TIMEOUT_SECONDS=20
# ORS_REQUEST_INTERVAL=0.55
# TANK_CAPACITY_GALLONS=50
# MILES_PER_GALLON=10
# FUEL_STATION_RADIUS_MILES=10
